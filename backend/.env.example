PORT=3000
NODE_ENV=development

# Cadena de conexión de MongoDB (local o Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/preentrega

# Orígenes permitidos por CORS, separados por coma (ej: URL del frontend deployado)
CORS_ORIGIN=http://localhost:5173

# Opcional: servidores DNS para resolver URIs "mongodb+srv://" si falla
# con "querySrv ECONNREFUSED" (pasa en algunas PCs con Windows)
# DNS_SERVERS=8.8.8.8,1.1.1.1
