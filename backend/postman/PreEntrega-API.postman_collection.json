{
  "info": {
    "name": "PreEntrega API",
    "description": "Colección para probar el backend (Express + Mongoose + Yup).\n\nUso:\n1. Levantá el backend con `npm run dev` dentro de /backend.\n2. Si deployaste, cambiá la variable `baseUrl` de la colección.\n3. Corré la colección completa con el Runner: los requests de creación guardan `productId` y `teamMemberId` para los siguientes.\n\nAviso: correrla crea y borra datos de prueba en la base configurada en MONGODB_URI.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "teamMemberId",
      "value": ""
    },
    {
      "key": "fakeId",
      "value": "000000000000000000000000"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Responde en menos de 5s', () => pm.expect(pm.response.responseTime).to.be.below(5000));",
          "if (pm.response.code !== 204) {",
          "  pm.test('Responde JSON con campo ok', () => pm.expect(pm.response.json()).to.have.property('ok'));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health",
        "description": "Estado del servidor y de la conexión a MongoDB."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('DB conectada', () => pm.expect(pm.response.json().db).to.eql('connected'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Productos",
      "item": [
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('data es un array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar categorías",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/categories",
            "description": "Categorías que tienen al menos un producto cargado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"data es un array de strings\", () => pm.expect(pm.response.json().data).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filtrar productos por categoría",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?category=Vientos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "Vientos"
                }
              ]
            },
            "description": "Equivalente a un where(\"category\", \"==\", \"Vientos\") de Firestore."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Todos son de la categoría pedida\", () => pm.response.json().data.forEach((p) => pm.expect(p.category).to.eql(\"Vientos\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear producto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bajo eléctrico Fender Jazz Bass\",\n  \"category\": \"Cuerdas\",\n  \"price\": 899.99,\n  \"stock\": 4,\n  \"image\": \"https://images.unsplash.com/photo-1525201548942-d8732f6617a0?auto=format&fit=crop&w=600&q=80\",\n  \"description\": \"Producto creado desde Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "var { data } = pm.response.json();",
                  "pm.test('Devuelve id', () => pm.expect(data.id).to.be.a('string'));",
                  "pm.test('No expone _id ni __v', () => { pm.expect(data).to.not.have.property('_id'); pm.expect(data).to.not.have.property('__v'); });",
                  "pm.collectionVariables.set('productId', data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener producto por id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Es el producto creado', () => pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('productId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar producto (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/products/{{productId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": 10,\n  \"price\": \"799.99\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Actualiza solo los campos enviados. El precio como string se convierte a número."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "var { data } = pm.response.json();",
                  "pm.test('Stock actualizado', () => pm.expect(data.stock).to.eql(10));",
                  "pm.test('Precio convertido a número', () => pm.expect(data.price).to.eql(799.99));",
                  "pm.test('Nombre sin cambios', () => pm.expect(data.name).to.eql('Bajo eléctrico Fender Jazz Bass'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reemplazar producto (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/products/{{productId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bajo eléctrico Fender Precision\",\n  \"category\": \"Cuerdas\",\n  \"price\": 950,\n  \"stock\": 2,\n  \"image\": \"https://images.unsplash.com/photo-1525201548942-d8732f6617a0?auto=format&fit=crop&w=600&q=80\",\n  \"description\": \"Reemplazado desde Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "PUT exige todos los campos obligatorios."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Nombre reemplazado', () => pm.expect(pm.response.json().data.name).to.eql('Bajo eléctrico Fender Precision'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar producto",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener producto eliminado (404)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "pm.test('ok es false', () => pm.expect(pm.response.json().ok).to.be.false);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Equipo",
